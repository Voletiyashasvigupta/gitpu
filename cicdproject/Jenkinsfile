// ============================================================
//  MASTER PIPELINE
//  Orchestrates 3 separate Jenkins jobs in sequence:
//    1. checkout      → pulls code, builds JAR, stashes workspace
//    2. imagecreate   → builds Docker image, pushes to Docker Hub
//    3. deploy        → deploys to Kubernetes
// ============================================================
pipeline {
    agent any

    environment {
        REGISTRY   = 'yashasvivoleti'     // <-- change to your Docker Hub username
        IMAGE_NAME = 'cicdproject'
    }

    stages {

        // ── STEP 1: Trigger the 'checkout' job ──────────────────────────
        stage('Checkout') {
    steps {
        git branch: 'main',
            url: 'https://github.com/Voletiyashasvigupta/gitpu.git'

        dir('cicdproject') {
            bat 'mvnw.cmd clean package -B'
        }
    }
}

        // ── STEP 2: Trigger the 'imagecreate' job ───────────────────────
  stage('Image Create') {
    steps {
        dir('cicdproject') {
            bat 'docker build -t cicdproject:%BUILD_NUMBER% -t cicdproject:latest .'
            bat 'docker images cicdproject'
        }
    }
}

        // ── STEP 3: Trigger the 'deploy' job (pass image tag) ───────────
        stage('Deploy') {
            steps {
                echo "Triggering job: deploy with IMAGE_TAG=${env.DEPLOY_TAG}..."
                build job: 'deploy',
                      wait: true,
                      propagate: true,
                      parameters: [
                          string(name: 'IMAGE_TAG', value: "${env.DEPLOY_TAG}")
                      ]
            }
        }
    }

    post {
        success {
            echo "Master Pipeline PASSED — all 3 jobs completed successfully!"
            echo "Live image: ${REGISTRY}/${IMAGE_NAME}:${env.DEPLOY_TAG}"
        }
        failure {
            echo "Master Pipeline FAILED — check which job failed above."
        }
    }
}
